{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cainiao524/CashRotate/presets/schema.json",
  "title": "CashRotate preset file",
  "description": "A JSON array of presets. Never include prices or logos. Validated by packages/core/tool/build_presets.dart.",
  "type": "array",
  "items": { "$ref": "#/$defs/preset" },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1 },
        "zh-Hant": { "type": "string", "minLength": 1 },
        "zh-Hans": { "type": "string", "minLength": 1 }
      }
    },
    "preset": {
      "type": "object",
      "required": ["id", "name", "category", "type", "defaultCycle", "regions", "color"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable forever. Templates start with template-." },
        "name": { "$ref": "#/$defs/localized" },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Nicknames, both Chinese scripts, abbreviations, domains, bank statement merchant names."
        },
        "category": {
          "enum": [
            "streaming", "music", "cloud", "software", "ai", "gaming", "reading", "creator", "vpn",
            "education", "fitness", "shopping", "communication", "domain", "hosting", "devtools",
            "gameServer", "telecom", "broadband", "utilities", "housing", "insurance", "loan", "tax",
            "transport", "family", "investing", "other"
          ]
        },
        "type": { "enum": ["subscription", "bill", "repayment", "insuranceAndFees", "transferOut"] },
        "defaultCycle": { "enum": ["daily", "weekly", "monthly", "bimonthly", "quarterly", "halfYearly", "yearly"] },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^(global|[A-Z]{2})$" }
        },
        "currency": {
          "description": "Only when the service bills in this currency everywhere (e.g. USD for AI services, JPY for pixivFANBOX).",
          "enum": [
            "TWD", "HKD", "MOP", "CNY", "JPY", "KRW", "MNT", "SGD", "MYR", "THB", "VND", "PHP", "IDR", "BND",
            "KHR", "LAK", "MMK", "INR", "PKR", "BDT", "LKR", "NPR", "BTN", "MVR", "AFN", "AUD", "NZD", "FJD",
            "PGK", "SBD", "VUV", "WST", "TOP", "XPF", "KZT", "UZS", "KGS", "TJS", "TMT", "USD", "EUR"
          ]
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "name"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "$ref": "#/$defs/localized" }
            }
          }
        },
        "remindDays": { "type": "integer", "minimum": 0, "maximum": 90, "default": 3 },
        "cancelUrl": { "type": "string", "pattern": "^https://" },
        "color": { "type": "string", "pattern": "^#[0-9A-F]{6}$", "description": "Brand colour for the initial badge." },
        "fields": {
          "type": "array",
          "items": { "enum": ["trial", "contract", "domain", "vps", "gameServer", "repayment", "policy"] }
        }
      }
    }
  }
}
